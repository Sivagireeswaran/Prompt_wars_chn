{
  "name": "recovrai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --env-file=.env tests/run-all-tests.mjs",
    "test:unit": "node --env-file=.env tests/test-api-chat.mjs && node --env-file=.env tests/test-api-education.mjs",
    "test:integration": "node --env-file=.env tests/test-api-clinic-search.mjs && node --env-file=.env tests/test-firebase-contacts.mjs",
    "test:accessibility": "node --env-file=.env tests/test-deaf-accessibility.mjs",
    "test:coverage": "node --env-file=.env tests/run-all-tests.mjs --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase": "^12.16.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.11"
  }
}
